# Адрес серверного обработчика заявок.
# Разворачивается из папки ../aivfx-lead-api (см. её README).
# Токен Telegram-бота хранится в переменных окружения Vercel и
# НИКОГДА не должен попадать в переменные с префиксом REACT_APP_:
# всё, что начинается с REACT_APP_, вшивается в JS-файл сайта и
# доступно любому посетителю.
REACT_APP_LEAD_API=https://aivfx-lead-api.vercel.app/api/lead

# Адрес серверного ассистента. Пока не задан — чат отвечает по прежнему
# сценарию из CHAT_DEMO, ничего не ломается.
REACT_APP_ASSISTANT_API=https://aivfx-lead-api.vercel.app/api/chat
